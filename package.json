{
  "name": "hospiagenda",
  "version": "0.1.0",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "private": true,
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm run test:audit-gate && pnpm run build && pnpm run test:e2e",
    "clean": "rimraf dist dist-electron dist-portable",
    "dev": "concurrently -k \"pnpm:dev:renderer\" \"pnpm:dev:electron\" \"pnpm:dev:app\"",
    "dev:renderer": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:app": "wait-on http://localhost:5173 dist-electron/main/index.js dist-electron/preload/index.cjs && node scripts/run-electron-dev.mjs",
    "build": "pnpm run build:renderer && pnpm run build:electron",
    "lint": "eslint src scripts/agent-browser-e2e.mjs scripts/packaged-startup-smoke.mjs",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:dist": "pnpm run build && electron-builder --dir",
    "build:dist:win": "pnpm run build && electron-builder --win --x64 --dir",
    "build:dist:mac": "pnpm run build && electron-builder --mac --dir",
    "build:dist:linux": "pnpm run build && electron-builder --linux --x64 --dir",
    "release:usb": "bash scripts/release-usb.sh",
    "test:audit-gate": "bash scripts/release-usb.audit.test.sh",
    "test:audit-gate:smoke": "AUDIT_GATE_SMOKE=1 bash scripts/release-usb.audit.test.sh",
    "test:e2e": "node scripts/agent-browser-e2e.mjs",
    "test:e2e:packaged": "node scripts/packaged-startup-smoke.mjs",
    "preview": "vite preview",
    "pretest": "pnpm run build:electron",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "fuse.js": "^7.4.2",
    "papaparse": "^5.5.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^24.12.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "5.1.0",
    "agent-browser": "0.37.1",
    "concurrently": "^10.0.6",
    "electron": "^43.8.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.0",
    "postcss": "^8.5.24",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.oiranca.phone-directory",
    "productName": "HospiAgenda",
    "copyright": "Copyright © 2026 Oiranca",
    "directories": {
      "output": "dist-portable",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "extraMetadata": {
      "scripts": null,
      "devDependencies": null,
      "build": null
    },
    "win": {
      "icon": "build-resources/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build-resources/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build-resources/entitlements.mac.plist",
      "entitlementsInherit": "build-resources/entitlements.mac.inherit.plist",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build-resources/icon.png",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office"
    }
  }
}
