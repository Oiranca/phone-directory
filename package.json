{
  "name": "hospiagenda",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "private": true,
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm run test:audit-gate && pnpm run build && pnpm run test:e2e",
    "clean": "rimraf dist dist-electron dist-portable",
    "dev": "concurrently -k \"pnpm:dev:renderer\" \"pnpm:dev:electron\" \"pnpm:dev:app\"",
    "dev:renderer": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:app": "wait-on http://localhost:5173 dist-electron/main/index.js dist-electron/preload/index.cjs && node scripts/run-electron-dev.mjs",
    "build": "pnpm run build:renderer && pnpm run build:electron",
    "lint": "eslint src tests",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:dist": "pnpm run build && electron-builder --dir",
    "build:dist:win": "pnpm run build && electron-builder --win --x64 --dir",
    "build:dist:mac": "pnpm run build && electron-builder --mac --dir",
    "build:dist:linux": "pnpm run build && electron-builder --linux --dir",
    "release:usb": "bash scripts/release-usb.sh",
    "test:audit-gate": "bash scripts/release-usb.audit.test.sh",
    "test:audit-gate:smoke": "AUDIT_GATE_SMOKE=1 bash scripts/release-usb.audit.test.sh",
    "test:e2e:packaged": "node scripts/packaged-startup-smoke.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "fuse.js": "^7.4.2",
    "papaparse": "^5.5.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^24.12.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "5.1.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.0",
    "postcss": "^8.5.24",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.0",
    "wait-on": "^9.1.0"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom@>=0.7.0 <0.9.0": "0.8.15",
      "@xmldom/xmldom@>=0.9.0 <0.9.12": "0.9.12",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "brace-expansion@>=3.0.0 <5.0.9": "5.0.9",
      "browserslist@<=4.28.6": "4.28.7",
      "fast-uri@>=3.0.0 <3.1.6": "3.1.6",
      "form-data": "^4.0.6",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "nanoid@<3.3.18": "3.3.18",
      "postcss-selector-parser@>=6.1.0 <6.1.3": "6.1.3",
      "tar": "^7.5.22",
      "tmp": "^0.2.7",
      "undici": "^6.27.0",
      "ws": "^8.21.1"
    }
  },
  "build": {
    "appId": "com.oiranca.phone-directory",
    "productName": "HospiAgenda",
    "copyright": "Copyright © 2026 Oiranca",
    "directories": {
      "output": "dist-portable",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "extraMetadata": {
      "scripts": null,
      "devDependencies": null,
      "build": null
    },
    "win": {
      "icon": "build-resources/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build-resources/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build-resources/entitlements.mac.plist",
      "entitlementsInherit": "build-resources/entitlements.mac.inherit.plist",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build-resources/icon.png",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office"
    }
  }
}
